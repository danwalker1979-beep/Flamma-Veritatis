# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
COMPANION_NAME=Aria
COMPANION_MODEL=claude-opus-5
PORT=3000

# Optional: expressive voice (laughter, tone, inflection) via ElevenLabs.
# Leave unset to fall back to the browser's built-in speech (talks, but can't laugh).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_v3

# Optional: named voices for age/tone control (young, mature, breathy, raspy...).
# Pick or design voices in ElevenLabs, then map labels to their voice ids.
# They show up in the in-app voice picker.
# ELEVENLABS_VOICES=Young=voiceIdA,Mature=voiceIdB,Breathy=voiceIdC
